# BioUnlock backend configuration (copy to server/.env for local development)
# NEVER commit a real .env file. All values below are placeholders.

# --- Application ---
BIOSECRET_KEY=change-me-to-a-long-random-string
BIO_ENVIRONMENT=development
BIO_LOG_LEVEL=INFO

# --- Database ---
# Development default (SQLite). For PostgreSQL use e.g.:
#   postgresql+psycopg://biounlock:password@localhost:5432/biounlock
BIO_DATABASE_URL=sqlite:///./biounlock.db

# --- WebAuthn relying party ---
# BIO_RP_ID must be the effective domain of the server (no scheme, no port).
BIO_RP_ID=localhost
BIO_RP_NAME=BioUnlock
# Comma separated list of allowed origins. Must be full origins.
BIO_ALLOWED_ORIGINS=http://localhost:8000,https://localhost:8000

# --- Sessions ---
BIO_SESSION_TTL_SECONDS=3600
BIO_CHALLENGE_TTL_SECONDS=120
BIO_PAIRING_TTL_SECONDS=300
BIO_AUTH_REQUEST_TTL_SECONDS=120
BIO_PAIRING_MAX_ATTEMPTS=5

# --- Server signing key (Ed25519) ---
# Optional path to a JSON file holding the server signing key. If unset a key
# is generated on first start in the server data directory. Provide a stable
# key in production so PC agents keep trusting the same server identity.
# BIO_SIGNING_KEY_PATH=/var/lib/biounlock/server_signing_key.json

# --- CORS ---
BIO_CORS_ORIGINS=http://localhost:8000

# --- Rate limiting ---
BIO_RATE_LIMIT_ENABLED=true

# --- Cookies ---
# Set to true in production behind HTTPS.
BIO_COOKIE_SECURE=false

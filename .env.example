# BioUnlock backend configuration (copy to server/.env for local development)
# NEVER commit a real .env file. All values below are placeholders.

# --- Application ---
BIO_ENVIRONMENT=development
BIO_LOG_LEVEL=INFO

# --- Owner API token ---
# The primary secret you must set. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The phone app and PC agent must use the same value. Required in production:
# owner endpoints and PC enrollment refuse to serve without it.
BIO_API_TOKEN=change-me-to-a-long-random-string

# --- Passkey enrollment token ---
# Once at least one passkey exists, adding or removing passkeys also requires
# this second secret (sent by the app as X-BioUnlock-Enrollment). The first
# passkey bootstraps with BIO_API_TOKEN alone. Generate it like the API token
# and enter it in the phone's Settings screen. Without it, changing passkeys
# fails closed on a deployment that already has one.
# BIO_ENROLLMENT_TOKEN=change-me-to-another-long-random-string

# --- Database ---
# Development default (SQLite). For PostgreSQL use e.g.:
#   postgresql+psycopg://biounlock:password@localhost:5432/biounlock
BIO_DATABASE_URL=sqlite:///./biounlock.db

# --- WebAuthn relying party ---
# Outside development BIO_RP_ID must be pinned to the domain the backend is
# served from (no scheme or port) — the server refuses to start otherwise.
# "auto" follows the request's host header and is only allowed in development.
BIO_RP_ID=auto
BIO_RP_NAME=BioUnlock
# Comma separated list of allowed origins. Must be full origins. Extra origins
# for the current host and the Android app (from the asset links file) are added
# automatically; the http://<rp_id>:8000 origin only in development.
BIO_ALLOWED_ORIGINS=http://localhost:8000,https://localhost:8000

# --- Sessions ---
BIO_SESSION_TTL_SECONDS=3600
BIO_CHALLENGE_TTL_SECONDS=120
BIO_PAIRING_TTL_SECONDS=300
BIO_AUTH_REQUEST_TTL_SECONDS=120
BIO_PAIRING_MAX_ATTEMPTS=5

# --- Server signing key (Ed25519) ---
# In development and explicit tests the key may be generated and stored in the
# local database. Deployed environments must set BIO_SIGNING_KEY from a secret
# store and keep it stable across deploys. Literal "\n" is accepted.
# BIO_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- CORS ---
BIO_CORS_ORIGINS=http://localhost:8000

# --- Rate limiting ---
BIO_RATE_LIMIT_ENABLED=true
# Deployed environments reject disabling rate limits.

# This file is for local development only; never use it for production secrets.
